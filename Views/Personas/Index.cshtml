@model IEnumerable<Logistica_y_transporte.Models.Persona>
@{
    ViewData["Title"] = "Personas";
    ViewData["PageTitle"] = "Gestión de personas";
    ViewData["PageSubtitle"] = "Personal vinculado a usuarios del sistema";
    ViewData["PageIcon"] = "bi-person-lines-fill";
    ViewData["ShowCreate"] = true;
}

<partial name="_ModulePageHeader" />

<div class="card module-card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state text-center py-5 m-4">
                <i class="bi bi-person display-4 text-muted"></i>
                <p class="text-muted mt-3 mb-3">No hay personas registradas.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Registrar primera persona</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-module table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Nombre)</th>
                            <th>@Html.DisplayNameFor(model => model.Apellido)</th>
                            <th>@Html.DisplayNameFor(model => model.Direccion)</th>
                            <th>@Html.DisplayNameFor(model => model.User)</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-medium">@(item.Nombre ?? "—")</td>
                                <td>@(item.Apellido ?? "—")</td>
                                <td class="text-truncate" style="max-width: 12rem;">@(item.Direccion ?? "—")</td>
                                <td><code class="small">@(item.User?.UserName ?? item.User?.Id ?? item.UserId ?? "—")</code></td>
                                <td class="text-end">
                                    <partial name="_CrudActions" view-data='new ViewDataDictionary(ViewData) { { "ItemId", item.personaId } }' />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
