@model Logistica_y_transporte.Models.Persona
@{
    ViewData["Title"] = "Eliminar persona";
    ViewData["PageTitle"] = "Eliminar persona";
    ViewData["PageSubtitle"] = "Esta acción no se puede deshacer";
    ViewData["PageIcon"] = "bi-exclamation-triangle-fill";
}

<partial name="_ModulePageHeader" />

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="alert alert-warning d-flex align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
            <div>¿Confirma que desea eliminar esta persona?</div>
        </div>
        <div class="card module-card border-danger border-opacity-25">
            <div class="card-body p-4">
                <dl class="row detail-list mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
                    <dd class="col-sm-8">@(Model?.Nombre ?? "—")</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Apellido)</dt>
                    <dd class="col-sm-8">@(Model?.Apellido ?? "—")</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Direccion)</dt>
                    <dd class="col-sm-8">@(Model?.Direccion ?? "—")</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.User)</dt>
                    <dd class="col-sm-8">@(Model?.User?.UserName ?? Model?.UserId ?? "—")</dd>
                </dl>
                <form asp-action="Delete" class="mt-4 d-flex flex-wrap gap-2">
                    <input type="hidden" asp-for="personaId" />
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Eliminar</button>
                    <partial name="_BackToList" />
                </form>
            </div>
        </div>
    </div>
</div>
