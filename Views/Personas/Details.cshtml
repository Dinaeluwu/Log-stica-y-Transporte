@model Logistica_y_transporte.Models.Persona
@{
    ViewData["Title"] = "Detalle de persona";
    ViewData["PageTitle"] = "Detalle de persona";
    ViewData["PageSubtitle"] = $"{Model?.Nombre} {Model?.Apellido}".Trim();
    ViewData["PageIcon"] = "bi-person-vcard-fill";
}

<partial name="_ModulePageHeader" />

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card module-card">
            <div class="card-body p-4">
                <dl class="row detail-list mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nombre)</dt>
                    <dd class="col-sm-8 fw-medium">@(Model?.Nombre ?? "—")</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Apellido)</dt>
                    <dd class="col-sm-8">@(Model?.Apellido ?? "—")</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Direccion)</dt>
                    <dd class="col-sm-8">@(Model?.Direccion ?? "—")</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.User)</dt>
                    <dd class="col-sm-8"><code>@(Model?.User?.UserName ?? Model?.User?.Id ?? Model?.UserId ?? "—")</code></dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex flex-wrap gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.personaId" class="btn btn-primary btn-sm"><i class="bi bi-pencil me-1"></i>Editar</a>
                <partial name="_BackToList" />
            </div>
        </div>
    </div>
</div>
