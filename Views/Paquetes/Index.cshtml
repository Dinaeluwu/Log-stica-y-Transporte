@model IEnumerable<Logistica_y_transporte.Models.Paquete>
@{
    ViewData["Title"] = "Paquetes";
    ViewData["PageTitle"] = "Gestión de paquetes";
    ViewData["PageSubtitle"] = "Contenido, peso y cliente asociado";
    ViewData["PageIcon"] = "bi-box-seam-fill";
    ViewData["ShowCreate"] = true;
}

<partial name="_ModulePageHeader" />

<div class="card module-card">
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="empty-state text-center py-5 m-4">
                <i class="bi bi-box display-4 text-muted"></i>
                <p class="text-muted mt-3 mb-3">No hay paquetes registrados.</p>
                <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Registrar primer paquete</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-module table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Cliente)</th>
                            <th>@Html.DisplayNameFor(model => model.descripcion)</th>
                            <th>@Html.DisplayNameFor(model => model.peso)</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-medium">@(item.Cliente?.nombre ?? "—")</td>
                                <td>@(item.descripcion ?? "—")</td>
                                <td><span class="badge text-bg-light border">@item.peso.ToString("N2") kg</span></td>
                                <td class="text-end">
                                    <partial name="_CrudActions" view-data='new ViewDataDictionary(ViewData) { { "ItemId", item.ID_paquete } }' />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
