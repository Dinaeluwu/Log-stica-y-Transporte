@model Logistica_y_transporte.Models.Paquete
@{
    ViewData["Title"] = "Nuevo paquete";
    ViewData["PageTitle"] = "Registrar paquete";
    ViewData["PageSubtitle"] = "Asocie el paquete a un cliente";
    ViewData["PageIcon"] = "bi-box-seam";
}

<partial name="_ModulePageHeader" />

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card module-card">
            <div class="card-header"><i class="bi bi-box me-2 text-primary"></i>Datos del paquete</div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="id_cliente" class="form-label"></label>
                        <select asp-for="id_cliente" class="form-select" asp-items="ViewBag.id_cliente"></select>
                        <span asp-validation-for="id_cliente" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="descripcion" class="form-label"></label>
                        <textarea asp-for="descripcion" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="descripcion" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="peso" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="peso" class="form-control" />
                            <span class="input-group-text">kg</span>
                        </div>
                        <span asp-validation-for="peso" class="text-danger small"></span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
                        <partial name="_BackToList" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
