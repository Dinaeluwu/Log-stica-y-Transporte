@model Logistica_y_transporte.Models.Paquete
@{
    ViewData["Title"] = "Detalle de paquete";
    ViewData["PageTitle"] = "Detalle de paquete";
    ViewData["PageSubtitle"] = Model?.descripcion;
    ViewData["PageIcon"] = "bi-box-seam";
}

<partial name="_ModulePageHeader" />

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card module-card">
            <div class="card-body p-4">
                <dl class="row detail-list mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Cliente)</dt>
                    <dd class="col-sm-8 fw-medium">@(Model?.Cliente?.nombre ?? "—")</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.descripcion)</dt>
                    <dd class="col-sm-8">@(Model?.descripcion ?? "—")</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.peso)</dt>
                    <dd class="col-sm-8">@Model?.peso.ToString("N2") kg</dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex flex-wrap gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.ID_paquete" class="btn btn-primary btn-sm"><i class="bi bi-pencil me-1"></i>Editar</a>
                <partial name="_BackToList" />
            </div>
        </div>
    </div>
</div>
