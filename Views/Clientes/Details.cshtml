@model Logistica_y_transporte.Models.ClienteModels
@{
    ViewData["Title"] = "Detalle de cliente";
    ViewData["PageTitle"] = "Detalle de cliente";
    ViewData["PageSubtitle"] = Model?.nombre;
    ViewData["PageIcon"] = "bi-person-vcard";
}

<partial name="_ModulePageHeader" />

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card module-card">
            <div class="card-body p-4">
                <dl class="row detail-list mb-0">
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.nombre)</dt>
                    <dd class="col-sm-8 fw-medium">@(Model?.nombre ?? "—")</dd>
                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.nit)</dt>
                    <dd class="col-sm-8">@(Model?.nit ?? "—")</dd>
                </dl>
            </div>
            <div class="card-footer bg-white d-flex flex-wrap gap-2">
                <a asp-action="Edit" asp-route-id="@Model?.Id_Cliente" class="btn btn-primary btn-sm"><i class="bi bi-pencil me-1"></i>Editar</a>
                <partial name="_BackToList" />
            </div>
        </div>
    </div>
</div>
