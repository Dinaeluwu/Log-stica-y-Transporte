@model Logistica_y_transporte.Models.ClienteModels
@{
    ViewData["Title"] = "Editar cliente";
    ViewData["PageTitle"] = "Editar cliente";
    ViewData["PageSubtitle"] = "Actualice la información del cliente";
    ViewData["PageIcon"] = "bi-pencil-square";
}

<partial name="_ModulePageHeader" />

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card module-card">
            <div class="card-header"><i class="bi bi-card-text me-2 text-primary"></i>Datos del cliente</div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <input type="hidden" asp-for="Id_Cliente" />
                    <div class="mb-3">
                        <label asp-for="nombre" class="form-label"></label>
                        <input asp-for="nombre" class="form-control form-control-lg" />
                        <span asp-validation-for="nombre" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="nit" class="form-label"></label>
                        <input asp-for="nit" class="form-control" />
                        <span asp-validation-for="nit" class="text-danger small"></span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar cambios</button>
                        <partial name="_BackToList" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
