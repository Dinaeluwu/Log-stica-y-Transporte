@model Logistica_y_transporte.Models.Ruta
@{
    ViewData["Title"] = "Nueva ruta";
    ViewData["PageTitle"] = "Registrar ruta";
    ViewData["PageSubtitle"] = "Defina zona y piloto asignado";
    ViewData["PageIcon"] = "bi-plus-circle-fill";
}

<partial name="_ModulePageHeader" />

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card module-card">
            <div class="card-header"><i class="bi bi-signpost-2 me-2 text-primary"></i>Datos de la ruta</div>
            <div class="card-body p-4">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="zona" class="form-label"></label>
                        <input asp-for="zona" class="form-control" />
                        <span asp-validation-for="zona" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="piloto" class="form-label"></label>
                        <input asp-for="piloto" class="form-control" />
                        <span asp-validation-for="piloto" class="text-danger small"></span>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
                        <partial name="_BackToList" />
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
