@{
    ViewData["Title"] = "Panel de Control - Logística y Envíos Rápidos";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    body {
        background-color: #002449; /* Fondo institucional profundo solicitado */
        color: #ffffff;
    }

    /* Contenedor principal estilo Hub de Operaciones / Cabina de Reparto */
    .logistic-hub {
        background: linear-gradient(145deg, #001a35, #002d5c);
        border: 2px solid #003f7f;
        border-radius: 16px;
        padding: 30px;
        box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
    }

    /* Tarjetas de métricas estilizadas como indicadores de tablero de control (Camión/Bus) */
    .dashboard-gauge {
        background-color: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-left: 5px solid #007bff !important;
        border-radius: 10px;
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

        .dashboard-gauge:hover {
            transform: translateY(-5px);
            background-color: rgba(255, 255, 255, 0.08);
            border-color: rgba(255, 255, 255, 0.25);
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }

    /* Variaciones de color para los bordes de los indicadores */
    .gauge-primary {
        border-left-color: #0d6efd !important;
    }

    .gauge-success {
        border-left-color: #198754 !important;
    }

    .gauge-warning {
        border-left-color: #ffc107 !important;
    }

    .gauge-info {
        border-left-color: #0dcaf0 !important;
    }

    /* Estilo de los accesos rápidos simulando rutas o despachos de flotilla */
    .route-link {
        background-color: rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(255, 255, 255, 0.08);
        color: #e0e6ed !important;
        border-radius: 8px;
        margin-bottom: 10px;
        transition: all 0.2s ease;
    }

        .route-link:hover {
            background-color: #0d6efd;
            color: #ffffff !important;
            padding-left: 25px;
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.4);
        }

    .badge-status {
        background-color: rgba(25, 135, 84, 0.2);
        color: #198754;
        border: 1px solid #198754;
    }
</style>

<div class="container-fluid px-4 mt-4">
    <div class="logistic-hub">

        <div class="row align-items-center mb-4 pb-3 border-bottom border-secondary border-opacity-25">
            <div class="col-md-8 col-sm-12">
                <div class="d-flex align-items-center">
                    <div class="p-3 bg-primary bg-opacity-10 rounded-3 me-3 border border-primary border-opacity-25">
                        <i class="bi bi-speedometer2 text-primary fs-3"></i>
                    </div>
                    <div>
                        <h1 class="h3 mb-1 fw-bold text-white">Consola de Despacho Global</h1>
                        <p class="text-info small mb-0 font-monospace">Logística y Envíos Rápidos S.A. &bull; Control Operativo de Flota</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4 col-sm-12 text-md-end text-sm-start mt-md-0 mt-3">
                <span class="badge badge-status p-2 fs-6 rounded-pill font-monospace">
                    <i class="bi bi-shield-check-fill me-1"></i> SLA: 99.9% HA ACTIVO
                </span>
            </div>
        </div>

        <div class="row mb-4">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card dashboard-card dashboard-gauge gauge-primary h-100">
                    <div class="card-body p-4">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-xs fw-bold text-info text-uppercase tracking-wider small mb-1">Manifiestos en Ruta</div>
                                <div class="h3 mb-0 fw-bold text-white font-monospace">1,248</div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-truck fs-2 text-white text-opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card dashboard-card dashboard-gauge gauge-success h-100">
                    <div class="card-body p-4">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-xs fw-bold text-success text-uppercase tracking-wider small mb-1">Entregas Efectivas</div>
                                <div class="h3 mb-0 fw-bold text-white font-monospace">412</div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-box-seam-fill fs-2 text-white text-opacity-50"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card dashboard-card dashboard-gauge gauge-warning h-100">
                    <div class="card-body p-4">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-xs fw-bold text-warning text-uppercase tracking-wider small mb-1">Alertas de Tránsito</div>
                                <div class="h3 mb-0 fw-bold text-white font-monospace">3</div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-exclamation-triangle-fill fs-2 text-warning"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card dashboard-card dashboard-gauge gauge-info h-100">
                    <div class="card-body p-4">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-xs fw-bold text-info text-uppercase tracking-wider small mb-1">Respaldo de Clientes</div>
                                <div class="h3 mb-0 fw-bold text-white font-monospace">100% Core</div>
                            </div>
                            <div class="col-auto">
                                <i class="bi bi-cloud-arrow-up-fill fs-2 text-info"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-lg-8 mb-4">
                <div class="card bg-black bg-opacity-20 border-0 h-100 rounded-3 text-white">
                    <div class="card-header bg-transparent border-bottom border-secondary border-opacity-25 py-3">
                        <h6 class="m-0 fw-bold text-info text-uppercase tracking-wide small">
                            <i class="bi bi-cone-striped me-2"></i>Estrategia de Continuidad Operativa
                        </h6>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-light leading-relaxed">
                            Esta plataforma centraliza la gestión logística para mitigar de forma definitiva las caídas críticas de fin de mes reportadas históricamente. Mediante arquitecturas redundantes de alta disponibilidad y la sincronización automatizada de datos, se asegura la permanencia del control operativo interno y la protección total de los registros de clientes de la empresa familiar.
                        </p>

                        <div class="p-3 bg-white bg-opacity-5 border border-secondary border-opacity-25 rounded-3 mt-4">
                            <div class="d-flex align-items-start">
                                <i class="bi bi-clipboard-data text-info fs-5 me-3 mt-1"></i>
                                <div>
                                    <strong class="text-white d-block mb-1">Evaluación de Arquitectura Empresarial (ERP)</strong>
                                    <span class="text-muted small">Análisis formal orientado a la toma de decisiones gerenciales: Ponderación estratégica de adquisición de software comercial (SaaS) frente a la viabilidad de desarrollo a la medida para soporte transaccional permanente.</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mb-4">
                <div class="card bg-black bg-opacity-20 border-0 h-100 rounded-3 text-white overflow-hidden">
                    <div class="card-header bg-transparent border-bottom border-secondary border-opacity-25 py-3">
                        <h6 class="m-0 fw-bold text-uppercase tracking-wide small text-info">
                            <i class="bi bi-signpost-split-fill me-2"></i>Rutas de Navegación
                        </h6>
                    </div>
                    <div class="list-group list-group-flush bg-transparent p-3">
                        <a asp-controller="Home" asp-action="Index" class="list-group-item list-group-item-action route-link py-3">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <div><i class="bi bi-plus-circle-fill text-primary me-2"></i> Registrar Nuevo Envío</div>
                                <i class="bi bi-chevron-right small opacity-50"></i>
                            </div>
                        </a>
                        <a asp-controller="Personas" asp-action="Index" class="list-group-item list-group-item-action route-link py-3">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <div><i class="bi bi-people-fill text-success me-2"></i> Base de Datos de Clientes</div>
                                <i class="bi bi-chevron-right small opacity-50"></i>
                            </div>
                        </a>
                        <a asp-controller="Home" asp-action="Privacy" class="list-group-item list-group-item-action route-link py-3">
                            <div class="d-flex w-100 justify-content-between align-items-center">
                                <div><i class="bi bi-shield-lock-fill text-info me-2"></i> Plan de Recuperación (DRP)</div>
                                <i class="bi bi-chevron-right small opacity-50"></i>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>
